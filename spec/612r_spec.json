  "procedures": [
    {"id": "op_board_cab", "title": "Board the cab", "audience": "operator", "steps": [
      {"text": "Lower the ladder with the ground-level ladder switch.", "camera": "left_side", "highlight": "SW_ladder_ground", "set": {"ladder": 0}},
      {"text": "Climb the ladder and open the cab door.", "highlight": "CTL_door_handle", "set": {"cab_door": 75}},
      {"text": "Sit down, close the door, and raise the ladder from the CommandARM.", "camera": "commandarm", "highlight": "SW_ladder", "set": {"cab_door": 0, "ladder": 80}}
    ]},
    {"id": "op_unfold_boom", "title": "Unfold the boom for field operation", "audience": "operator", "steps": [
      {"text": "Stop the machine on level ground with overhead clearance. Put it in Park.", "camera": "commandarm", "highlight": "BTN_park", "state": {"park": true}},
      {"text": "Raise the boom to full height so the wings clear the cradles and tires.", "highlight": "BTN_boom_raise", "set": {"boom_height": 2.4}},
      {"text": "Swing both main wings out (fold OUT).", "camera": "overview", "highlight": ["SW_fold_L_out", "SW_fold_R_out"], "set": {"fold_L": 0, "fold_R": 0}},
      {"text": "Unfold both outer wings.", "highlight": ["SW_outer_L_out", "SW_outer_R_out"], "set": {"outer_L": 0, "outer_R": 0}},
      {"text": "Lower the boom to spray height (typically 50-76 cm above the target).", "camera": "field", "highlight": "BTN_boom_lower", "set": {"boom_height": 0.76}}
    ]},
    {"id": "op_fold_boom", "title": "Fold the boom for transport", "audience": "operator", "steps": [
      {"text": "Turn master spray OFF and stop the machine.", "camera": "commandarm", "highlight": "BTN_master_spray", "state": {"spray_on": false, "park": true}},
      {"text": "Level both wings (tilt to 0) and raise the boom to full height.", "highlight": "BTN_boom_raise", "set": {"tilt_L": 0, "tilt_R": 0, "boom_height": 2.4}},
      {"text": "Fold both outer wings IN onto the inner wings.", "camera": "overview", "highlight": ["SW_outer_L_in", "SW_outer_R_in"], "set": {"outer_L": 178, "outer_R": 178}},
      {"text": "Fold both main wings IN until they rest in the cradles.", "highlight": ["SW_fold_L_in", "SW_fold_R_in"], "set": {"fold_L": 90, "fold_R": 90}},
      {"text": "Lower the boom until the wings rest in the cradles, then select Road mode.", "highlight": "BTN_transport", "set": {"boom_height": 2.2}, "state": {"road_mode": true}}
    ]},
    {"id": "op_adjust_tread", "title": "Adjust tread width (120-160 in)", "audience": "operator", "steps": [
      {"text": "Find a firm, level area with room to drive slowly in a straight line.", "camera": "overview"},
      {"text": "Take the machine out of Park and drive slowly forward.", "highlight": "CTL_hydro_handle", "state": {"park": false, "speed_kph": 3}},
      {"text": "Hold the tread WIDER (or NARROWER) switch until the display shows the target width.", "camera": "wheel_FL", "highlight": "SW_tread_wide", "set": {"tread": 3.81}},
      {"text": "Stop, and confirm the tread width on all four legs.", "state": {"speed_kph": 0}}
    ]},
    {"id": "op_drive", "title": "Drive forward with the hydro handle", "audience": "operator", "steps": [
      {"text": "Start the engine, raise the ladder, take the machine out of Park.", "camera": "commandarm", "highlight": ["SW_ladder", "BTN_park"], "set": {"ladder": 80}, "state": {"park": false}},
      {"text": "Push the hydro handle forward to accelerate. Pull it back to slow down.", "highlight": "CTL_hydro_handle", "set": {"hydro_handle": 15}}
    ]},
    {"id": "mx_engine_access", "title": "Open the engine compartment for daily service", "audience": "mechanic", "steps": [
      {"text": "Park the machine, lower the boom, stop the engine, remove the key.", "camera": "commandarm", "state": {"park": true}, "set": {"boom_height": 0.76}},
      {"text": "Release the hood latch and raise the engine hood.", "camera": "engine", "highlight": "CTL_hood_latch", "set": {"hood": 65}},
      {"text": "Check engine oil at the dipstick.", "highlight": "SVC_engine_oil"},
      {"text": "Inspect the air filter restriction indicator and housing.", "highlight": "SVC_air_filter"},
      {"text": "Drain water from the fuel filter / water separator.", "highlight": "SVC_fuel_filter"},
      {"text": "Inspect the cooling package for debris.", "highlight": "SVC_cooling"}
    ]},
    {"id": "mx_strainers", "title": "Clean the solution system strainers", "audience": "operator", "steps": [
      {"text": "Turn master spray off and park. Relieve system pressure.", "camera": "commandarm", "highlight": "BTN_master_spray", "state": {"spray_on": false, "park": true}},
      {"text": "Suction strainer (20 mesh): close the tank valve and remove the bowl.", "camera": "left_side", "highlight": "SVC_suction_strainer"},
      {"text": "Pressure strainer (50 mesh).", "highlight": "SVC_pressure_strainer"},
      {"text": "Boom strainer (80 mesh), at the centre frame.", "camera": "boom_center", "highlight": "SVC_boom_strainer"}
    ]},
    {"id": "op_fill_eductor", "title": "Fill using the side fill and chemical eductor", "audience": "operator", "steps": [
      {"text": "Park the machine and lower the ladder for access.", "camera": "left_side", "set": {"ladder": 0}, "state": {"park": true}},
      {"text": "Connect the water supply to the 3 in quick-fill coupler.", "highlight": "SVC_quick_fill"},
      {"text": "Lower the chemical eductor to working height.", "highlight": "CTL_eductor_handle", "set": {"eductor": 85}},
      {"text": "When you finish, rinse the eductor and raise it to the stowed position.", "highlight": "CTL_eductor_handle", "set": {"eductor": 0}}
    ]}
  ]
}
