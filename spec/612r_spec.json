  "interlocks": [
    {"id": "il_fold_height",   "applies_to": ["fold_L", "fold_R"], "rule": "boom_height >= 2.1",
     "message": "Raise the boom above the tires before you fold or unfold the main wings.", "physical": true,
     "note": "Physical: the folded wings rest at cradle height. Below about 2.1 m nozzle height they would hit the tires. The geometry is checked live in the viewer."},
    {"id": "il_outer_before_main", "applies_to": ["fold_L", "fold_R"], "rule": "folding IN requires outer_X >= 170",
     "message": "Fold the outer wing onto the inner wing before you swing the main wing forward.", "physical": true},
    {"id": "il_main_before_outer_out", "applies_to": ["outer_L", "outer_R"], "rule": "unfolding outer requires fold_X == 0",
     "message": "Unfold the main wing completely before you unfold the outer wing.", "physical": true},
    {"id": "il_tread_rolling", "applies_to": ["tread"], "rule": "abs(ground_speed) > 0.3 km/h AND abs(ground_speed) < 8 km/h",
     "message": "Tread adjust only moves while the machine rolls slowly; the wheels must roll to slide in or out.", "physical": true,
     "note": "Speed window is an ESTIMATE. Check the OM."},
    {"id": "il_drive_ladder",  "applies_to": ["drive"], "rule": "ladder == 80 (raised)", "message": "Raise the ladder before you drive.", "physical": false, "verified": false},
    {"id": "il_drive_park",    "applies_to": ["drive"], "rule": "park == false", "message": "Take the machine out of Park.", "physical": false},
    {"id": "il_road_folded",   "applies_to": ["road_mode"], "rule": "boom fully folded", "message": "Road mode requires the boom folded and in the cradles.", "physical": false, "verified": false},
    {"id": "il_spray_unfolded","applies_to": ["spray_on"], "rule": "boom fully unfolded AND not road_mode", "message": "Spraying requires the boom fully unfolded.", "physical": false, "verified": false}
  ],

