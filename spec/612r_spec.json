     "note": "asin(wheelbase / turning radius) = 27.9 deg. The inner wheel follows Ackermann geometry."},
    {"id": "tread",            "label": "Tread width", "type": "translate", "unit": "m", "min": 3.05, "max": 4.06, "default": 3.05, "rate": 0.05,
     "nodes": {"PIV_tread_FL": "+half", "PIV_tread_RL": "+half", "PIV_tread_FR": "-half", "PIV_tread_RR": "-half"}, "src": "OFFICIAL",
     "note": "Rate is an ESTIMATE. Hydraulic tread adjust only moves while the machine is rolling (see interlocks)."},
    {"id": "suspension",       "label": "Air-ride strut travel", "type": "translate", "unit": "m", "min": -0.10, "max": 0.10, "default": 0, "rate": 0.5,
