    {"id": "tip_R",            "label": "Right breakaway", "type": "rotate", "unit": "deg", "min": -35, "max": 35, "default": 0, "rate": 90, "nodes": {"PIV_tip_R": "z-"}, "src": "ESTIMATE", "spring_return": true},
    {"id": "ladder",           "label": "Hydraulic ladder", "type": "rotate", "unit": "deg", "min": 0, "max": 80, "default": 0, "rate": 30, "nodes": {"PIV_ladder": "y-"}, "src": "OFFICIAL",
