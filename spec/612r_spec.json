    {"id": "tilt_R",           "label": "Right wing tilt", "type": "rotate", "unit": "deg", "min": -8, "max": 18, "default": 0, "rate": 6, "nodes": {"PIV_tilt_R": "x-"}, "src": "ESTIMATE"},
    {"id": "fold_L",           "label": "Left main fold",  "type": "rotate", "unit": "deg", "min": 0, "max": 90,  "default": 0, "rate": 9,  "nodes": {"PIV_fold_L": "z-"}, "src": "ESTIMATE"},
