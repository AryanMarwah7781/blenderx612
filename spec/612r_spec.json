    {"id": "cab_door",         "label": "Cab door", "type": "rotate", "unit": "deg", "min": 0, "max": 80, "default": 0, "rate": 60, "nodes": {"PIV_cab_door": "z+"}, "src": "ESTIMATE"},
    {"id": "hood",             "label": "Engine hood (front nose, tilts up)", "type": "rotate", "unit": "deg", "min": 0, "max": 65, "default": 0, "rate": 30, "nodes": {"PIV_hood": "y-"}, "src": "ESTIMATE"},
    {"id": "eductor",          "label": "Chemical eductor", "type": "rotate", "unit": "deg", "min": 0, "max": 85, "default": 0, "rate": 40, "nodes": {"PIV_eductor": "x-", "PIV_eductor_level": "x+"}, "src": "ESTIMATE"},
    {"id": "hydro_handle",     "label": "Hydro handle (MFWD lever)", "type": "rotate", "unit": "deg", "min": -12, "max": 25, "default": 0, "rate": 40, "nodes": {"PIV_hydro_handle": "y+"}, "src": "ESTIMATE",
     "note": "Forward = forward travel. Lever angle maps to the commanded fraction of the selected range."},
    {"id": "steering_wheel",   "label": "Steering wheel", "type": "rotate", "unit": "deg", "min": -540, "max": 540, "default": 0, "rate": 360, "nodes": {"PIV_steering_wheel": "z"}, "src": "ESTIMATE",
     "note": "About 3 turns lock to lock (ESTIMATE). It drives the steer joint."}
