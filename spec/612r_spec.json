    {"id": "outer_R",          "label": "Right outer fold","type": "rotate", "unit": "deg", "min": 0, "max": 178, "default": 0, "rate": 18, "nodes": {"PIV_outer_R": "z-"}, "src": "ESTIMATE"},
    {"id": "tip_L",            "label": "Left breakaway",  "type": "rotate", "unit": "deg", "min": -35, "max": 35, "default": 0, "rate": 90, "nodes": {"PIV_tip_L": "z+"}, "src": "ESTIMATE",
